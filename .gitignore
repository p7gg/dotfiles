# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp

# Local scratch space
/.tmp/

# Never commit private key material by accident.
id_rsa
id_ed25519
id_ecdsa
*.pem
*.key
*.agekey
*.p12
*.pfx
*.jks
*.keystore
key.txt

# Runtime auth/state files generated by chezmoi targets.
home/dot_config/gh/hosts.yml
home/dot_config/opencode/service.json
home/dot_config/opencode/auth.json
home/dot_config/opencode/log/
home/dot_config/opencode/cache/
home/dot_config/git/allowed_signers
home/dot_config/bws/state
home/dot_config/fish/fish_variables
home/dot_config/fish/fish_history
home/dot_config/fish/completions/
home/private_dot_ssh/agent.env

# Credential files that must stay out of the repository.
.env
.env.*
!.env.example
credentials.json
application_default_credentials.json
service-account*.json

# Public keys are fine.
!*.pub
