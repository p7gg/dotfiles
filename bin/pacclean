#!/usr/bin/env bash
# pacclean — interactive storage cleanup for Arch Linux
# Usage: pacclean [--aggressive|-a] [--yes|-y]
set -euo pipefail

AGGRESSIVE=0
ASSUME_YES=0
for arg in "$@"; do
    case "$arg" in
        -a|--aggressive) AGGRESSIVE=1 ;;
        -y|--yes)        ASSUME_YES=1 ;;
        -h|--help)
            echo "usage: pacclean [-a|--aggressive] [-y|--yes]"
            echo "  -a, --aggressive  default to aggressive options"
            echo "  -y, --yes         skip confirmation prompts"
            exit 0 ;;
        *) echo "unknown option: $arg" >&2; exit 1 ;;
    esac
done

info()  { printf "\033[1;34m➜\033[0m %s\n" "$1"; }
ok()    { printf "\033[1;32m✓\033[0m %s\n" "$1"; }
warn()  { printf "\033[1;33m⚠\033[0m %s\n" "$1"; }
dim()   { printf "\033[2m%s\033[0m\n" "$1"; }

df_root() { df -h / | awk 'NR==2 {print $4" free"}'; }

confirm() {
    [ "$ASSUME_YES" -eq 1 ] && return 0
    local reply
    read -r -p "$1 [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

ask_aggressive() {
    [ "$AGGRESSIVE" -eq 1 ] && return 0
    local reply
    read -r -p "$1 [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

BEFORE=$(df_root)
printf "\n\033[1mpacclean\033[0m — disk cleanup\n"
info "disk before: $BEFORE"
printf "\n"

# ── 1. Pacman package cache ──────────────────────────────────────────────
if command -v paccache >/dev/null 2>&1; then
    CACHE_SIZE=$(du -sh /var/cache/pacman/pkg 2>/dev/null | cut -f1 || true)
    CACHE_SIZE=${CACHE_SIZE:-unknown}
    info "pacman cache: ${CACHE_SIZE}"
    if ask_aggressive "  remove ALL cached versions except currently installed? (aggressive)"; then
        sudo paccache -ruk0 && ok "removed caches of uninstalled + old versions"
    else
        confirm "  remove old cached versions (keep last 3)?" && { sudo paccache -r && ok "old package caches removed"; } || dim "skipped"
    fi
else
    warn "paccache not found (install pacman-contrib)"
fi

# ── 2. Orphan packages ───────────────────────────────────────────────────
ORPHANS=$(pacman -Qtdq 2>/dev/null || true)
if [ -n "$ORPHANS" ]; then
    info "orphan packages:"
    dim "$(echo "$ORPHANS" | sed 's/^/    /')"
    if ask_aggressive "  remove orphans WITH their dependency chains? (aggressive: pacman -Rns --recursive)"; then
        echo "$ORPHANS" | sudo pacman -Rns --recursive --noconfirm - && ok "orphans removed recursively"
    else
        confirm "  remove orphan packages?" && echo "$ORPHANS" | sudo pacman -Rns --noconfirm - && ok "orphans removed"
    fi
else
    ok "no orphan packages"
fi

# ── 3. AUR build cache (~/.cache/yay) ────────────────────────────────────
if [ -d "${HOME}/.cache/yay" ]; then
    YAY_SIZE=$(du -sh "${HOME}/.cache/yay" 2>/dev/null | cut -f1)
    info "AUR build cache (~/.cache/yay): ${YAY_SIZE}"
    confirm "  clear AUR build cache?" && { rm -rf "${HOME}/.cache/yay/"* && ok "AUR cache cleared"; } || dim "skipped"
fi

# ── 4. Systemd journal ───────────────────────────────────────────────────
if command -v journalctl >/dev/null 2>&1; then
    JOURNAL_SIZE=$(journalctl --disk-usage 2>/dev/null | grep -oP '\d+.*$' || echo "?")
    info "systemd journal: ${JOURNAL_SIZE}"
    if ask_aggressive "  vacuum journal to 50MB? (aggressive; otherwise 500MB)"; then
        sudo journalctl --vacuum-size=50M && ok "journal vacuumed to 50M"
    else
        confirm "  vacuum journal to 500MB?" && { sudo journalctl --vacuum-size=500M && ok "journal vacuumed"; } || dim "skipped"
    fi
fi

# ── 5. User cache (~/.cache) ─────────────────────────────────────────────
CACHE_TOTAL=$(du -sh "${HOME}/.cache" 2>/dev/null | cut -f1 || echo "?")
info "user cache (~/.cache): ${CACHE_TOTAL}"
if ask_aggressive "  wipe ENTIRE ~/.cache? (aggressive — apps will rebuild caches slowly)"; then
    confirm "  really wipe all of ~/.cache?" && { rm -rf "${HOME}/.cache/"* && ok "user cache wiped"; } || dim "skipped"
else
    confirm "  clear thumbnails and browser caches only?" && {
        rm -rf "${HOME}/.cache/thumbnails" 2>/dev/null || true
        rm -rf "${HOME}/.cache/mozilla" "${HOME}/.cache/chromium" "${HOME}/.cache/BraveSoftware" "${HOME}/.cache/google-chrome" 2>/dev/null || true
        ok "thumbnails + browser caches cleared"
    } || dim "skipped"
fi

# ── 6. Trash ─────────────────────────────────────────────────────────────
TRASH="${HOME}/.local/share/Trash"
if [ -d "$TRASH" ]; then
    TRASH_SIZE=$(du -sh "$TRASH" 2>/dev/null | cut -f1)
    info "trash: ${TRASH_SIZE}"
    confirm "  empty trash?" && { rm -rf "$TRASH/files/"* "$TRASH/info/"* 2>/dev/null; ok "trash emptied"; } || dim "skipped"
fi

# ── 7. Mise tool cache ───────────────────────────────────────────────────
if command -v mise >/dev/null 2>&1; then
    MISE_CACHE=$(du -sh "${HOME}/.local/share/mise/downloads" 2>/dev/null | cut -f1 || echo "?")
    info "mise downloads cache: ${MISE_CACHE}"
    confirm "  prune stale mise downloads?" && { mise cache clear && rm -rf "${HOME}/.local/share/mise/downloads/"* 2>/dev/null; ok "mise cache cleared"; } || dim "skipped"
fi

# ── 8. JS package manager caches ─────────────────────────────────────────
if command -v npm >/dev/null 2>&1 && [ -d "${HOME}/.npm" ]; then
    NPM_SIZE=$(du -sh "${HOME}/.npm" 2>/dev/null | cut -f1)
    info "npm cache (~/.npm): ${NPM_SIZE}"
    confirm "  clean npm cache?" && { npm cache clean --force >/dev/null 2>&1; ok "npm cache cleaned"; } || dim "skipped"
fi

if command -v pnpm >/dev/null 2>&1; then
    PNPM_STORE=$(pnpm store path 2>/dev/null || true)
    if [ -n "$PNPM_STORE" ] && [ -d "$PNPM_STORE" ]; then
        PNPM_SIZE=$(du -sh "$PNPM_STORE" 2>/dev/null | cut -f1)
        info "pnpm store (${PNPM_STORE}): ${PNPM_SIZE}"
        # prune only removes packages not referenced by any project — safe
        confirm "  prune unreferenced packages from pnpm store?" && { pnpm store prune >/dev/null 2>&1; ok "pnpm store pruned"; } || dim "skipped"
    fi
fi

if command -v bun >/dev/null 2>&1 && [ -d "${HOME}/.bun/install/cache" ]; then
    BUN_SIZE=$(du -sh "${HOME}/.bun/install/cache" 2>/dev/null | cut -f1)
    info "bun cache: ${BUN_SIZE}"
    confirm "  clean bun install cache?" && { bun pm cache rm >/dev/null 2>&1; ok "bun cache cleaned"; } || dim "skipped"
fi

# ── 9. Rust caches ───────────────────────────────────────────────────────
if [ -d "${HOME}/.cargo/registry" ]; then
    CARGO_SIZE=$(du -sh "${HOME}/.cargo/registry" 2>/dev/null | cut -f1)
    info "cargo registry: ${CARGO_SIZE}"
    if ask_aggressive "  remove extracted crate sources AND cached .crate files? (aggressive — next build re-downloads)"; then
        rm -rf "${HOME}/.cargo/registry/src" "${HOME}/.cargo/registry/cache" && ok "cargo registry cleared"
    else
        # removing src/ only is cheap: crates re-extract from local .crate archives, no re-download
        confirm "  remove extracted sources only (keeps .crate archives)?" && { rm -rf "${HOME}/.cargo/registry/src" && ok "extracted crate sources removed"; } || dim "skipped"
    fi
fi

if command -v rustup >/dev/null 2>&1; then
    TOOLCHAINS=$(rustup toolchain list 2>/dev/null | grep -v '(default)' | grep -v '(override)' | grep -cv '(active)' || true)
    if [ "${TOOLCHAINS:-0}" -gt 0 ]; then
        info "rustup toolchains (non-default):"
        dim "$(rustup toolchain list | grep -v '(default)' | grep -v '(override)' | grep -v '(active)' | sed 's/^/    /')"
        confirm "  remove non-default rustup toolchains?" && {
            rustup toolchain list | grep -v '(default)' | grep -v '(override)' | grep -v '(active)' | awk '{print $1}' | while read -r tc; do
                rustup toolchain uninstall "$tc" >/dev/null 2>&1 && ok "removed $tc"
            done
        } || dim "skipped"
    else
        ok "no stale rustup toolchains"
    fi
fi

# ── 10. Dev tool caches (opencode, playwright) ───────────────────────────
if [ -d "${HOME}/.cache/opencode" ]; then
    OC_SIZE=$(du -sh "${HOME}/.cache/opencode" 2>/dev/null | cut -f1)
    info "opencode cache: ${OC_SIZE}"
    confirm "  clear opencode cache?" && { rm -rf "${HOME}/.cache/opencode/"* && ok "opencode cache cleared"; } || dim "skipped"
fi

if [ -d "${HOME}/.cache/ms-playwright" ]; then
    PW_SIZE=$(du -sh "${HOME}/.cache/ms-playwright" 2>/dev/null | cut -f1)
    info "playwright browsers: ${PW_SIZE}"
    if ask_aggressive "  delete ALL playwright browsers? (aggressive — re-download on next test run)"; then
        rm -rf "${HOME}/.cache/ms-playwright/"* && ok "playwright browsers removed"
    else
        dim "skipped"
    fi
fi

AFTER=$(df_root)
printf "\n"
info "done! disk after: $AFTER (was: $BEFORE)"
