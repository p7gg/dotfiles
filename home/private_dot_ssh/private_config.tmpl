# Global defaults.
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes
    ControlMaster auto
    ControlPath ~/.ssh/control-%C
    ControlPersist 10m

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519

{{ if .work_email -}}
# Google Cloud Source Repositories (work).
Host source.developers.google.com
    HostName source.developers.google.com
    Port 2022
    User {{ .work_email }}
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
{{ end -}}

# Tailscale devices: any tailnet machine name works as a host alias, so
# `ssh gabriel@laptop` reaches the device named laptop. `tailscale ip` resolves
# the name from tailscaled's peer list and `tailscale nc` carries the session
# through the daemon, so this does not depend on the OS resolving MagicDNS
# names. Hosts that are not tailnet devices are left to the normal resolver.
Match exec "tailscale ip -4 '%h' >/dev/null 2>&1"
    ProxyCommand tailscale nc "$(tailscale ip -4 '%h')" %p
