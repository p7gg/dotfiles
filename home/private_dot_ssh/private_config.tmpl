{{ if .work_email -}}
# Google Cloud Source Repositories (work). Keep this before Host * so the
# multiplexing opt-out wins: ssh_config uses the first value it obtains.
Host source.developers.google.com
    HostName source.developers.google.com
    Port 2022
    User {{ .work_email }}
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    # Cloud Source Repositories can return PERMISSION_DENIED when a persisted
    # master outlives its original client. Use a fresh connection per fetch.
    ControlMaster no
    ControlPath none
{{ end -}}

# Global defaults.
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes
    ControlMaster auto
    # Keep multiplexing sockets under the user's home. Unlike an
    # XDG_RUNTIME_DIR-based path, this still works for cron jobs and agent
    # processes that do not inherit the variable. ControlPersist closes idle
    # masters; see docs/auth.md for cleanup.
    ControlPath %d/.ssh/control-%C
    ControlPersist 10m

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519

{{ if contains "microsoft" .chezmoi.kernel.osrelease -}}
# WSL tools started outside a login shell (T3, OpenCode, systemd scopes) do not
# inherit SSH_AUTH_SOCK from fish. Use the Windows agent relay socket directly.
Match exec "test -S /run/user/{{ .chezmoi.uid }}/ssh-agent.sock"
    IdentityAgent /run/user/{{ .chezmoi.uid }}/ssh-agent.sock
{{ end -}}

# Tailscale devices: any tailnet machine name works as a host alias, so
# `ssh gabriel@laptop` reaches the device named laptop. `tailscale ip` resolves
# the name from tailscaled's peer list and `tailscale nc` carries the session
# through the daemon, so this does not depend on the OS resolving MagicDNS
# names. Skip public hosts and localhost: the daemon lookup costs ~200ms and
# must not run for every GitHub/GitLab fetch.
Match host "*,!github.com,!gitlab.com,!source.developers.google.com,!localhost,!127.0.0.1,!::1" exec "timeout 1 tailscale ip -4 '%h' >/dev/null 2>&1"
    ProxyCommand tailscale nc "$(tailscale ip -4 '%h')" %p
