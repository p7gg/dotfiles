[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
    signingkey = ~/.ssh/id_ed25519.pub

[init]
    defaultBranch = main

[core]
    autocrlf = input
    excludesFile = ~/.config/git/ignore

{{ if lookPath "delta" -}}
[core]
    pager = delta
{{ end -}}

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true
    writeCommitGraph = true

[rebase]
    autoStash = true
    updateRefs = true

[rerere]
    enabled = true
    autoupdate = true

[merge]
    conflictStyle = zdiff3

[status]
    showUntrackedFiles = all

[commit]
    verbose = true
    gpgsign = true

[color]
    ui = auto

[diff]
    algorithm = histogram
    colorMoved = default

{{ if lookPath "delta" -}}
[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
{{ end -}}

[alias]
    co = checkout
    ch = !fish -c 'fzf-checkout $argv'
{{- if lookPath "difft" }}
    dt = !difft
{{- end }}

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname
    gpgsign = true

[log]
    date = iso

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers
    # ssh-keygen does not read ~/.ssh/config, so IdentityAgent cannot reach the
    # WSL relay from processes without SSH_AUTH_SOCK. The wrapper sets it.
    program = {{ .chezmoi.homeDir }}/.local/bin/git-ssh-sign.sh

# Work projects under ~/Projects/work/ use the work email, while still signing
# with the same per-machine SSH key. Skip the include entirely when the work
# email is blank so a personal-only machine does not get user.email="".
{{ if .work_email -}}
[includeIf "gitdir:~/Projects/work/"]
    path = ~/.config/git/work.inc
{{ end -}}
