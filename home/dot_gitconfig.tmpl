[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
    signingkey = ~/.ssh/id_ed25519.pub

[init]
    defaultBranch = main

[core]
    autocrlf = input
    excludesFile = ~/.config/git/ignore
    pager = delta

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true
    writeCommitGraph = true

[rebase]
    autoStash = true
    updateRefs = true

[rerere]
    enabled = true
    autoupdate = true

[merge]
    conflictStyle = zdiff3

[status]
    showUntrackedFiles = all

[commit]
    verbose = true
    gpgsign = true

[color]
    ui = auto

[diff]
    algorithm = histogram
    colorMoved = default

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true

[alias]
    dt = !difft

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname
    gpgsign = true

[log]
    date = iso

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

# Work projects under ~/Projects/work/ use the work email, while still signing
# with the same per-machine SSH key.
[includeIf "gitdir:~/Projects/work/"]
    path = ~/.config/git/work.inc
