[Unit]
Description=WSL2 SSH agent bridge to the Windows OpenSSH agent
Documentation=https://github.com/mame/wsl2-ssh-agent
After=network.target

[Service]
Type=simple
ConditionUser=!root
ExecStart=%h/.local/bin/wsl2-ssh-agent --verbose --foreground --socket=%t/wsl2-ssh-agent.sock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
