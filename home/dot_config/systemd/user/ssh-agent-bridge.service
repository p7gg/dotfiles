[Unit]
Description=SSH agent bridge to the Windows agent
Documentation=https://github.com/albertony/npiperelay
After=network.target
ConditionUser=!root

[Service]
Type=simple
UMask=0077
ExecStart=%h/.local/bin/ssh-agent-bridge
Restart=always
RestartSec=2
RestartPreventExitStatus=1
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
